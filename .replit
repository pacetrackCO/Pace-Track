modules = ["nodejs-20", "web", "python-base-3.13", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PaceTrack"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "timing-unit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "timing-browser"

[[workflows.workflow]]
name = "PaceTrack"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 5000

[[workflows.workflow]]
name = "timing-unit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node tests/verify-interface.mjs && node --test tests/*.test.cjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "timing-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tests/run-browser-checks.py"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 22004
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start", "--", "23636"]
